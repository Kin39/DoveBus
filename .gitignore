node_modules/
dist/
coverage/

# Built SQLite databases and downloaded feeds (never committed — 125 MB+)
data/
*.db
*.db-wal
*.db-shm
*.zip

.env
.env.*
!.env.example
.DS_Store

# Local workflow log: records checkpoints with machine-local SHAs
.claude/checkpoints.log
# Local dev-server harness: machine-specific (it carries the --host flag used to
# reach the dev server from a phone on the LAN) and irrelevant once the site is
# served from Netlify.
.claude/launch.json

# Screenshot-loop artifacts: regenerated by `npm run shots` against live data
client/shots/
client/shots-site/

# Transient render input for `npm run og` (see client/scripts/og.ts)
client/scripts/.og.staged.html

# Generated line/comune/index pages: written by `npm run seo-pages` from
# client/seo/lines.json and client/seo/published.json, which *are* committed.
# Netlify regenerates them at build time, so the HTML itself is derived.
client/linea/
client/comune/
client/linee/
