# Where the DoveBus API lives. The frontend and backend are decoupled: this is
# the one place the address is written.
VITE_API_BASE=http://localhost:3200

# Where the pageview counter lives — a GoatCounter on the same VPS as the API.
#
# Deliberately unset here, and unset in every build that is not the deploy. A
# build without it ships no counter at all: the constant folds to `undefined`,
# the bundler drops the module, and the CSP names no counter origin. Setting it
# is what makes the site count, so setting it by accident is the one mistake
# worth making loud — `assertCounterAgreesWithCsp` in `vite.config.ts` fails the
# build if the bundle and the header ever disagree about whether it is set.
#
# VITE_STATS_BASE=https://stats.dovebus.it
