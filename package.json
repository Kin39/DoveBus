{
  "name": "dovebus",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time map of Autolinee Toscane buses in Tuscany",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "import": "npm run import --workspace=server --",
    "refresh": "npm run refresh --workspace=server --",
    "verify": "npm run verify --workspace=server --",
    "poll": "npm run poll --workspace=server --",
    "serve": "npm run serve --workspace=server --",
    "test": "npm run test --workspace=server",
    "coverage": "npm run coverage --workspace=server",
    "typecheck": "npm run typecheck --workspace=server",
    "lint": "biome lint server",
    "check": "biome check server",
    "check:fix": "biome check --write server",
    "format": "biome format --write server"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8"
  }
}
