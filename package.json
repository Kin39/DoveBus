{
  "name": "dovebus",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time map of Autolinee Toscane buses in Tuscany",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "build:client": "npm run build --workspace=client",
    "shots": "npm run shots --workspace=client --",
    "site-shots": "npm run site-shots --workspace=client --",
    "og": "npm run og --workspace=client",
    "import": "npm run import --workspace=server --",
    "refresh": "npm run refresh --workspace=server --",
    "verify": "npm run verify --workspace=server --",
    "poll": "npm run poll --workspace=server --",
    "serve": "npm run serve --workspace=server --",
    "test": "npm run test --workspace=server",
    "coverage": "npm run coverage --workspace=server",
    "typecheck": "npm run typecheck --workspace=server",
    "lint": "biome lint server client/src client/scripts",
    "check": "biome check server client/src client/scripts",
    "check:fix": "biome check --write server client/src client/scripts",
    "format": "biome format --write server client/src client/scripts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8"
  }
}
